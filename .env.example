# Copia este fichero como ".env" y rellena los valores. El fichero .env NO se sube a git
# ni se copia en la imagen Docker. En Dokploy, pega estas líneas en la pestaña "Environment".

# Contraseña de acceso a la demo (recomendado: 12 caracteres o más).
# Vacía = acceso libre, solo aceptable en un portátil sin exponer a Internet.
CLAVE_ACCESO=

# Secreto para firmar las sesiones (opcional). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se deja vacío, se genera al arrancar y las sesiones caducan al reiniciar el contenedor.
SECRETO_SESION=

# Duración de la sesión en horas
SESION_HORAS=12

# Datos públicos al arrancar (1 = sí, 0 = no)
DATOS_PUBLICOS=0

# Semilla de la simulación
SEMILLA=2026

# Prefijo de publicación. Vacío si la app tiene su propio dominio o subdominio
# (https://gemelos.tudominio.es/). Si nginx la publica en una ruta
# (https://tudominio.es/gemelos/), pon esa ruta: BASE_PATH=/gemelos
BASE_PATH=

# Puerto local (solo en 127.0.0.1) para abrir la demo en el propio equipo
PUERTO_LOCAL=8080
